// Tasks for the Wimhof breathing exercise app.
// Default shortcut: Alt+Shift+T in Zed editor.
// If you're here, you will be using debug mode.
// See presets/debug.yaml accordingly.
// Good luck!

[
  {
    "label": "Debug with debug config",
    "command": "uv run wimhof -b presets/debug.yaml",
    "use_new_terminal": false,
  },
  {
    "label": "Run",
    "command": "uv run wimhof",
    "use_new_terminal": false,
  },
  {
    "label": "Run 4-7-8",
    "command": "uv run wimhof -b presets/4-7-8.yaml",
    "use_new_terminal": false,
  },
  {
    "label": "Run Box Breathing",
    "command": "uv run wimhof -b presets/box_breathing.yaml",
    "use_new_terminal": false,
  },
  {
    "label": "Ruff",
    "command": "uv run ruff check src/",
    "use_new_terminal": false,
  },
  {
    "label": "Ruff format",
    "command": "uv run ruff format --check src/",
    "use_new_terminal": false,
  },
  {
    "label": "Ruff format fix",
    "command": "uv run ruff format src/",
    "use_new_terminal": false,
  },
  {
    "label": "Mypy",
    "command": "uv run mypy src/wimhof",
    "use_new_terminal": false,
  },
  {
    "label": "Audit",
    "command": "uv audit --preview-features audit",
    "use_new_terminal": false,
  },
  {
    "label": "Build",
    "command": "uv build",
    "use_new_terminal": false,
  },
]
